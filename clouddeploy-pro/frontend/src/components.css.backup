/* Modern Components CSS aligned with Design System */

.dashboard-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0.75rem;
}

.dashboard-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 0.75rem;
  margin-bottom: 0.75rem;
}

.dashboard-column {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.dashboard-full-width {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  margin-top: 0.75rem;
}

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0.5rem;
}

.metric-card {
  background-color: var(--bg-tertiary, #1E1B2E);
  border-radius: var(--border-radius-sm, 0.375rem);
  padding: 0.65rem 0.75rem;
  text-align: left;
  border: 1px solid rgba(147, 51, 234, 0.2);
  transition: transform var(--transition-fast, 120ms ease), border-color 120ms ease;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.metric-card:hover {
  border-color: var(--accent-cyan, #06B6D4);
  box-shadow: var(--glow-cyan);
}

.metric-label {
  font-size: 0.725rem;
  color: var(--text-muted, #94A3B8);
  margin-bottom: 0.25rem;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  font-weight: 600;
}

.metric-value {
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--text-primary, #E2E8F0);
  font-family: var(--font-display);
}

/* Card Header Override */
.card-header {
  background-color: var(--bg-tertiary, #1E1B2E) !important;
  border-bottom: 1px solid rgba(147, 51, 234, 0.2);
  padding: 0.55rem 0.85rem;
}

.card-title {
  color: var(--text-primary, #E2E8F0) !important;
  font-size: 0.9rem;
  font-weight: 600;
}

.card-content {
  padding: 0.75rem 0.85rem;
  background-color: transparent;
}

/* Environment Details */
.env-details {
  background-color: var(--bg-secondary, #151622);
  border-radius: var(--border-radius-lg, 0.65rem);
  padding: 0.65rem 0.85rem;
  border: 1px solid rgba(147, 51, 234, 0.2);
}

.env-item {
  display: flex;
  justify-content: space-between;
  padding: 0.4rem 0;
  border-bottom: 1px solid rgba(147, 51, 234, 0.1);
  font-size: 0.825rem;
}

.env-item:last-child {
  border-bottom: none;
}

.env-label {
  font-weight: 500;
  color: var(--text-muted, #94A3B8);
}

.env-value {
  color: var(--accent-cyan, #06B6D4);
  font-family: var(--font-mono);
  font-weight: 600;
}

/* Chart Bars */
.chart-bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  height: 100%;
  padding-top: 0.75rem;
  gap: 0.75rem;
}

.chart-bar {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  height: 100%;
  justify-content: flex-end;
}

.chart-bar-fill {
  width: 60%;
  max-width: 32px;
  background: linear-gradient(180deg, var(--accent-cyan, #06B6D4) 0%, rgba(147, 51, 234, 0.4) 100%);
  border-radius: 3px 3px 0 0;
  box-shadow: 0 0 8px rgba(6, 182, 212, 0.3);
  transition: height var(--transition-medium, 220ms ease);
}

.chart-bar-label {
  margin-top: 0.35rem;
  font-size: 0.75rem;
  color: var(--text-secondary, #CBD5E1);
  font-weight: 500;
}

.chart-bar-value {
  font-size: 0.725rem;
  color: var(--accent-emerald, #10B981);
  font-weight: 700;
  margin-top: 0.15rem;
}

/* Page Container */
.page-container {
  max-width: 1440px;
  margin: 0 auto;
}

/* Pipeline Timeline */
.pipeline-timeline {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.pipeline-step {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.45rem 0.75rem;
  background-color: var(--bg-tertiary, #1E1B2E);
  border-radius: var(--border-radius-sm, 0.375rem);
  border: 1px solid rgba(147, 51, 234, 0.2);
}

.step-content {
  display: flex;
  flex-direction: column;
  gap: 0.1rem;
}

.step-label {
  font-weight: 600;
  color: var(--text-primary, #E2E8F0);
  font-size: 0.85rem;
}

.step-duration {
  font-size: 0.7rem;
  color: var(--text-muted, #94A3B8);
}

.step-status {
  display: flex;
  align-items: center;
  gap: 0.35rem;
}

.pipeline-step.success .status-label {
  color: var(--status-healthy, #10B981);
  text-transform: uppercase;
  font-size: 0.7rem;
  font-weight: 700;
}

.pipeline-step.running .status-label {
  color: var(--accent-cyan, #06B6D4);
  text-transform: uppercase;
  font-size: 0.7rem;
  font-weight: 700;
}

.pipeline-step.pending .status-label {
  color: var(--text-muted, #94A3B8);
  text-transform: uppercase;
  font-size: 0.7rem;
  font-weight: 700;
}

/* Infrastructure Grid */
.infra-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0.5rem;
}

.infra-card {
  background-color: var(--bg-tertiary, #1E1B2E);
  padding: 0.55rem 0.75rem;
  border-radius: var(--border-radius-sm, 0.375rem);
  border: 1px solid rgba(147, 51, 234, 0.2);
  transition: all var(--transition-fast);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
}

.infra-card:hover {
  border-color: var(--accent-cyan, #06B6D4);
  box-shadow: var(--glow-cyan);
}

.infra-icon {
  font-size: 1.25rem;
  margin-bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.infra-title {
  font-size: 0.725rem;
  color: var(--text-muted, #94A3B8);
  margin-bottom: 0.15rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.4px;
}

.infra-value {
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--accent-cyan, #06B6D4);
  word-break: break-all;
  font-family: var(--font-mono);
  background-color: rgba(6, 182, 212, 0.1);
  padding: 0.15rem 0.4rem;
  border-radius: 3px;
  display: inline-block;
  max-width: 100%;
}

/* Status Badges */
.status-badge {
  display: inline-block;
  padding: 0.15rem 0.5rem;
  border-radius: 0.25rem;
  font-size: 0.675rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.4px;
  margin-top: 0;
}

.status-healthy {
  background-color: rgba(16, 185, 129, 0.15);
  color: var(--status-healthy, #10B981);
  border: 1px solid rgba(16, 185, 129, 0.35);
}

.status-warning {
  background-color: rgba(245, 158, 11, 0.15);
  color: var(--status-warning, #F59E0B);
  border: 1px solid rgba(245, 158, 11, 0.35);
}

.status-error {
  background-color: rgba(244, 63, 94, 0.15);
  color: var(--status-error, #F43F5E);
  border: 1px solid rgba(244, 63, 94, 0.35);
}

.status-unknown {
  background-color: rgba(100, 116, 139, 0.15);
  color: var(--status-unknown, #64748B);
  border: 1px solid rgba(100, 116, 139, 0.3);
}

/* Tooltip styling */
.infra-card[title] {
  position: relative;
  cursor: help;
}

.infra-card[title]:hover::after {
  content: attr(title);
  position: absolute;
  bottom: 100%;
  left: 50%;
  transform: translateX(-50%);
  background-color: rgba(13, 14, 21, 0.95);
  color: var(--accent-cyan);
  border: 1px solid var(--accent-cyan);
  padding: 0.4rem 0.65rem;
  border-radius: 4px;
  font-size: 0.75rem;
  white-space: nowrap;
  z-index: 1000;
  margin-bottom: 0.5rem;
  box-shadow: var(--glow-cyan);
}