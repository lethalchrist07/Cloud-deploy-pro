/* Design System - High-Availability Cyberpunk Mode (Bold & Innovative) */

/* Import Google Fonts - MUST be first */
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap');

/* Color Palette & Spacing Tokens */
:root {
  /* 60% Background: Midnight Violet Obsidian */
  --bg-primary: #0D0E15;
  --bg-secondary: #151622;
  --bg-tertiary: #1E1B2E;
  --bg-hover: #2B2544;

  /* 30% Primary Elements: Automation Purple & Steel Text */
  --accent-purple: #9333EA;
  --accent-purple-light: #A855F7;
  --accent-purple-glow: rgba(147, 51, 234, 0.35);
  
  --text-primary: #E2E8F0; /* Steel Text */
  --text-secondary: #CBD5E1;
  --text-muted: #94A3B8;
  --text-dim: #64748B;
  --text-bright: #FFFFFF;

  /* 10% Accent / CTA: Laser Rose & Electric Cyan */
  --accent-rose: #F43F5E;
  --accent-rose-glow: rgba(244, 63, 94, 0.4);
  --accent-cyan: #06B6D4;
  --accent-cyan-glow: rgba(6, 182, 212, 0.35);

  /* Legacy mapping aliases */
  --accent-blue: #06B6D4;
  --accent-emerald: #10B981;

  /* Status Colors */
  --status-healthy: #10B981;
  --status-deploying: #F59E0B;
  --status-rolled-back: #F43F5E;
  --status-unknown: #64748B;

  /* Borders & Cyberpunk Glows */
  --border-radius-sm: 0.375rem;
  --border-radius: 0.5rem;
  --border-radius-lg: 0.65rem;
  --border: 1px solid rgba(147, 51, 234, 0.2);
  --border-active: 1px solid rgba(6, 182, 212, 0.45);
  --glass-bg: rgba(21, 22, 34, 0.85);
  --glass-border: rgba(147, 51, 234, 0.18);
  --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.4);
  --shadow-md: 0 4px 14px rgba(13, 14, 21, 0.6);
  --shadow-lg: 0 8px 24px rgba(13, 14, 21, 0.8);
  --glow-cyber: 0 0 15px rgba(147, 51, 234, 0.25);
  --glow-rose: 0 0 12px rgba(244, 63, 94, 0.4);
  --glow-cyan: 0 0 12px rgba(6, 182, 212, 0.4);

  /* Typography */
  --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
  --font-display: 'Outfit', system-ui, sans-serif;
  --font-mono: 'JetBrains Mono', monospace;

  /* Fast Smooth Transitions */
  --transition-fast: 120ms ease;
  --transition-medium: 220ms cubic-bezier(0.4, 0, 0.2, 1);

  /* Compact Spacing */
  --space-0: 0;
  --space-1: 0.15rem;
  --space-2: 0.35rem;
  --space-3: 0.5rem;
  --space-4: 0.75rem;
  --space-5: 1rem;
  --space-6: 1.25rem;
  --space-8: 1.5rem;
  --space-10: 2rem;
}

/* Base resets */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html, body, #root {
  height: 100%;
  background-color: var(--bg-primary);
  color: var(--text-primary);
  font-family: var(--font-sans);
  font-size: 14px;
  line-height: 1.45;
  -webkit-font-smoothing: antialiased;
}

/* Cyberpunk Scrollbar */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}
::-webkit-scrollbar-track {
  background: var(--bg-primary);
}
::-webkit-scrollbar-thumb {
  background: #2D274A;
  border-radius: 3px;
  border: 1px solid rgba(147, 51, 234, 0.3);
}
::-webkit-scrollbar-thumb:hover {
  background: var(--accent-cyan);
  box-shadow: var(--glow-cyan);
}

/* Glassmorphism utility */
.glass {
  background: var(--glass-bg);
  border: var(--glass-border);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-radius: var(--border-radius-lg);
}

/* Cyberpunk Buttons */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  font-weight: 600;
  border-radius: var(--border-radius-sm);
  cursor: pointer;
  transition: all var(--transition-fast);
  border: none;
  font-family: var(--font-sans);
  font-size: 0.8rem;
  padding: 0.4rem 0.8rem;
  white-space: nowrap;
}

.btn-primary {
  background: linear-gradient(135deg, var(--accent-purple) 0%, var(--accent-purple-light) 100%);
  color: #FFFFFF;
  box-shadow: 0 2px 10px rgba(147, 51, 234, 0.4);
  border: 1px solid rgba(168, 85, 247, 0.5);
}

.btn-primary:hover {
  filter: brightness(1.2);
  box-shadow: 0 4px 16px rgba(147, 51, 234, 0.6);
  transform: translateY(-1px);
}

.btn-primary:active {
  transform: translateY(0);
}

.btn-secondary {
  background-color: var(--bg-tertiary);
  color: var(--text-primary);
  border: 1px solid rgba(147, 51, 234, 0.25);
}

.btn-secondary:hover {
  background-color: var(--bg-hover);
  border-color: var(--accent-cyan);
  color: var(--accent-cyan);
  box-shadow: var(--glow-cyan);
}

.btn-icon {
  width: 2rem;
  height: 2rem;
  padding: 0;
  border-radius: var(--border-radius-sm);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background-color: var(--bg-tertiary);
  border: 1px solid rgba(147, 51, 234, 0.2);
  color: var(--text-secondary);
}

.btn-icon:hover {
  background-color: var(--bg-hover);
  color: var(--accent-cyan);
  border-color: var(--accent-cyan);
  box-shadow: var(--glow-cyan);
}

.btn-rose {
  background: linear-gradient(135deg, #E11D48 0%, var(--accent-rose) 100%);
  color: #FFFFFF;
  box-shadow: var(--glow-rose);
}

.btn-rose:hover {
  filter: brightness(1.2);
}

/* Status Badges */
.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  font-size: 0.7rem;
  font-weight: 700;
  padding: 0.2rem 0.5rem;
  border-radius: var(--border-radius-sm);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.status-healthy {
  background-color: rgba(16, 185, 129, 0.15);
  color: var(--status-healthy);
  border: 1px solid rgba(16, 185, 129, 0.35);
  box-shadow: 0 0 8px rgba(16, 185, 129, 0.2);
}

.status-deploying {
  background-color: rgba(245, 158, 11, 0.15);
  color: var(--status-deploying);
  border: 1px solid rgba(245, 158, 11, 0.35);
}

.status-rolled-back {
  background-color: rgba(244, 63, 94, 0.15);
  color: var(--status-rolled-back);
  border: 1px solid rgba(244, 63, 94, 0.4);
  box-shadow: var(--glow-rose);
}

.status-unknown {
  background-color: rgba(100, 116, 139, 0.15);
  color: var(--status-unknown);
  border: 1px solid rgba(100, 116, 139, 0.3);
}

/* Inputs */
.input {
  width: 100%;
  padding: 0.4rem 0.65rem;
  background-color: var(--bg-tertiary);
  border: 1px solid rgba(147, 51, 234, 0.25);
  border-radius: var(--border-radius-sm);
  color: var(--text-primary);
  font-family: var(--font-sans);
  transition: all var(--transition-fast);
  font-size: 0.8rem;
}

.input:focus {
  outline: none;
  border-color: var(--accent-cyan);
  box-shadow: 0 0 0 2px rgba(6, 182, 212, 0.25);
}

/* Cards */
.card {
  background-color: var(--bg-secondary);
  border-radius: var(--border-radius-lg);
  overflow: hidden;
  border: 1px solid rgba(147, 51, 234, 0.2);
  transition: all var(--transition-fast);
}

.card:hover {
  border-color: rgba(6, 182, 212, 0.4);
  box-shadow: var(--shadow-cyber);
}

.card-header {
  padding: 0.6rem 0.85rem;
  background-color: var(--bg-tertiary);
  border-bottom: 1px solid rgba(147, 51, 234, 0.2);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-title {
  font-size: 0.95rem;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: var(--space-2);
  color: var(--text-primary);
}

.card-content {
  padding: 0.75rem 0.85rem;
}

/* Layout containers */
.container {
  width: 100%;
  max-width: 1440px;
  margin: 0 auto;
  padding: 0.75rem 1rem;
}

/* Tab styling */
.tabs {
  display: flex;
  border-bottom: 1px solid rgba(147, 51, 234, 0.2);
  margin-bottom: var(--space-4);
  gap: 0.25rem;
}

.tab {
  padding: 0.4rem 0.75rem;
  cursor: pointer;
  transition: all var(--transition-fast);
  font-weight: 500;
  font-size: 0.8rem;
  position: relative;
  color: var(--text-muted);
  border-radius: var(--border-radius-sm) var(--border-radius-sm) 0 0;
}

.tab:hover {
  color: var(--text-primary);
}

.tab.active {
  color: var(--accent-cyan);
  font-weight: 600;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: -1px;
  left: 0;
  right: 0;
  height: 2px;
  background-color: var(--accent-cyan);
  box-shadow: var(--glow-cyan);
}

/* Tables */
.table {
  width: 100%;
  border-collapse: collapse;
}

.table th,
.table td {
  padding: 0.5rem 0.75rem;
  text-align: left;
  border-bottom: 1px solid rgba(147, 51, 234, 0.12);
}

.table th {
  font-weight: 600;
  color: var(--text-muted);
  text-transform: uppercase;
  font-size: 0.75rem;
  letter-spacing: 0.05em;
  background-color: var(--bg-tertiary);
}

.table tbody tr:hover {
  background-color: rgba(147, 51, 234, 0.08);
}

/* Charts container */
.chart-container {
  height: 210px;
  position: relative;
}

/* Logs styles */
.logs-viewer {
  background-color: var(--bg-secondary);
  border-radius: var(--border-radius-lg);
  overflow: hidden;
  border: 1px solid rgba(147, 51, 234, 0.2);
  max-height: 280px;
  overflow-y: auto;
  font-family: var(--font-mono);
}

.log-entry {
  display: flex;
  justify-content: space-between;
  padding: 0.35rem 0.65rem;
  border-bottom: 1px solid rgba(147, 51, 234, 0.08);
  font-size: 0.8rem;
}

.log-entry:last-child {
  border-bottom: none;
}

.log-timestamp {
  color: var(--text-muted);
  font-size: 0.75rem;
}

.log-level {
  text-transform: uppercase;
  font-weight: 600;
  font-size: 0.75rem;
}

.log-level.info {
  color: var(--status-healthy);
}

.log-level.warn {
  color: var(--status-deploying);
}

.log-level.error {
  color: var(--accent-rose);
}

.log-message {
  flex: 1;
  margin-left: 0.5rem;
  color: var(--text-primary);
}

/* Placeholder text */
.placeholder {
  text-align: center;
  color: var(--text-muted);
  font-style: italic;
  padding: 1rem;
  font-size: 0.85rem;
}

/* Grid layouts */
.metrics-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0.6rem;
}

.pipeline-timeline {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.pipeline-step {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.45rem 0.75rem;
  border-radius: var(--border-radius-sm);
  border: 1px solid rgba(147, 51, 234, 0.2);
  background-color: var(--bg-tertiary);
  transition: all var(--transition-fast);
}

.pipeline-step:hover {
  border-color: var(--accent-cyan);
  box-shadow: var(--glow-cyan);
}

.pipeline-step.pending {
  border-style: dashed;
}

.pipeline-step.running {
  border-color: var(--accent-cyan);
  background-color: rgba(6, 182, 212, 0.08);
}

.pipeline-step.success {
  border-color: var(--status-healthy);
  background-color: rgba(16, 185, 129, 0.08);
}

.pipeline-step.failed {
  border-color: var(--accent-rose);
  background-color: rgba(244, 63, 94, 0.08);
}

.step-content {
  display: flex;
  flex-direction: column;
  gap: 0.1rem;
}

.step-label {
  font-weight: 600;
  font-size: 0.85rem;
}

.step-duration {
  font-size: 0.7rem;
  color: var(--text-muted);
}

.step-status {
  display: flex;
  align-items: center;
  gap: 0.3rem;
  font-size: 0.7rem;
}

.status-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
}

.status-dot.pending { background-color: var(--text-muted); }
.status-dot.running { background-color: var(--accent-cyan); box-shadow: var(--glow-cyan); }
.status-dot.success { background-color: var(--status-healthy); box-shadow: 0 0 6px var(--status-healthy); }
.status-dot.failed { background-color: var(--accent-rose); box-shadow: var(--glow-rose); }

.status-label {
  text-transform: capitalize;
}

/* Infrastructure grid */
.infrastructure-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0.6rem;
}

.infra-card {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0.55rem 0.75rem;
  background-color: var(--bg-tertiary);
  border-radius: var(--border-radius-sm);
  border: 1px solid rgba(147, 51, 234, 0.2);
}

.infra-icon {
  font-size: 1.25rem;
  display: flex;
  align-items: center;
  justify-content: center;
}

.infra-content {
  display: flex;
  flex-direction: column;
}

.infra-title {
  font-size: 0.75rem;
  color: var(--text-muted);
  font-weight: 500;
}

.infra-value {
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--text-primary);
}

/* Responsive breakpoints */
@media (max-width: 1200px) {
  .metrics-grid, .infrastructure-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 768px) {
  .metrics-grid, .infrastructure-grid {
    grid-template-columns: 1fr;
  }
  .container {
    padding: 0.5rem;
  }
}