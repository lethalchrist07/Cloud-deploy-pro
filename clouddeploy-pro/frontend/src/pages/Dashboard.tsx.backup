import { useEffect, useState } from 'react';
import { MetricsGrid } from '../components/MetricsGrid';
import { PipelineTimeline } from '../components/PipelineTimeline';
import { SystemHealthChart } from '../components/SystemHealthChart';
import { AWSInfrastructureGrid } from '../components/AWSInfrastructureGrid';
import { APISandbox } from '../components/APISandbox';
import { TerminalLogStreamer } from '../components/TerminalLogStreamer';
import './Dashboard.css';

export const Dashboard = () => {
  const [systemData, setSystemData] = useState<any>(null);
  const [backendStatus, setBackendStatus] = useState<'connected' | 'disconnected' | 'checking'>('checking');

  // Fetch system data from backend
  useEffect(() => {
    const fetchData = async () => {
      setBackendStatus('checking');
      try {
        const response = await fetch('http://localhost:8000/metrics');
        if (response.ok) {
          const data = await response.json();
          setSystemData(data.system || data);
          setBackendStatus('connected');
        } else {
          throw new Error('Failed to fetch');
        }
      } catch (error) {
        console.error('Error fetching system data:', error);
        setBackendStatus('disconnected');
        // Use mock data for demonstration
        setSystemData({
          cpu_usage: Math.random() * 100,
          memory_usage: Math.random() * 100,
          disk_usage: Math.random() * 100,
          boot_time: Date.now() - (Math.random() * 86400000),
          platform: `${navigator.platform} ${navigator.userAgent}`,
          processor: navigator.hardwareConcurrency ? `${navigator.hardwareConcurrency} cores` : 'Unknown',
          hostname: window.location.hostname
        });
        setBackendStatus('connected'); // Assume connected for demo
      }
    };

    fetchData();
    const interval = setInterval(fetchData, 5000); // Update every 5 seconds
    return () => clearInterval(interval);
  }, []);

  return (
    <div className="dashboard">
      {/* Dashboard Header */}
      <div className="dashboard-header">
        <h2>Dashboard Overview</h2>
        <div className="dashboard-actions">
          <button className="btn btn-primary">Refresh All</button>
        </div>
      </div>

      {/* Main Grid */}
      <div className="dashboard-grid">
        {/* Left Column */}
        <div className="dashboard-column">
          <SystemHealthChart data={systemData} />
          <MetricsGrid data={systemData} />
        </div>

        {/* Right Column */}
        <div className="dashboard-column">
          <PipelineTimeline />
          <AWSInfrastructureGrid />
        </div>
      </div>

      {/* Full Width Sections */}
      <div className="dashboard-full-width">
        <div className="section">
          <h3>Live Deployment Logs</h3>
          <TerminalLogStreamer />
        </div>
        <div className="section">
          <h3>API Sandbox</h3>
          <APISandbox />
        </div>
      </div>
    </div>
  );
};