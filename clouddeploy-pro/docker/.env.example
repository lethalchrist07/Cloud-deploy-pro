# CloudDeploy Pro - Local Development Environment
# Copy this file to docker/.env for local docker-compose usage

# Application Settings
ENVIRONMENT=development
APP_VERSION=1.0.0
DEBUG=true
NODE_ENV=development

# Port Configuration
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Git/Deployment Info (populated by CI/CD in production)
# GIT_COMMIT=
# DEPLOYED_AT=
