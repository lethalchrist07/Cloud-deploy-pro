"""
Repository Inspection Module for CloudDeploy Pro
Handles inspection of public GitHub repositories in a read-only manner.
Enhanced to provide comprehensive project analysis for deployment configuration.
"""
import re
import requests
import json
import logging
from typing import Dict, Any, List, Optional
from urllib.parse import urlparse

# Configure logging
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

class GitHubInspectionError(Exception):
    """Custom exception for GitHub inspection errors."""
    pass

class RepositoryInspector:
    """Inspects public GitHub repositories for deployment readiness."""

    GITHUB_API_BASE = "https://api.github.com"
    
    # Files to check for in the repository
    FILES_TO_CHECK = {
        "package_json": "package.json",
        "requirements_txt": "requirements.txt",
        "pyproject_toml": "pyproject.toml",
        "dockerfile": "Dockerfile",
        "docker_compose": "docker-compose.yml",
        "compose": "compose.yml",  # alternative docker compose file
        "terraform": None,  # we'll check for .tf files and terraform directory
        "package_lock": "package-lock.json",
        "pom_xml": "pom.xml",
        "go_mod": "go.mod",
        "cargo_toml": "Cargo.toml",
        "makefile": "Makefile",
        "gitignore": ".gitignore",
        "env_example": ".env.example",
        "env_sample": ".env.sample"
    }

    # CI/CD configuration files to check
    CI_CD_FILES = {
        "github_actions": ".github/workflows",
        "gitlab_ci": ".gitlab-ci.yml",
        "travis_ci": ".travis.yml",
        "circle_ci": ".circleci",
        "jenkins": "Jenkinsfile",
        "azure_pipelines": "azure-pipelines.yml"
    }

    def __init__(self):
        self.session = requests.Session()
        # Set a user agent to avoid being blocked by GitHub
        self.session.headers.update({
            "User-Agent": "CloudDeploy-Pro-Inspector/1.0",
            "Accept": "application/vnd.github.v3+json"
        })

    def _get_file_content(self, owner: str, repo: str, path: str, ref: str) -> Optional[str]:
        """
        Fetch the content of a file from the repository.
        Returns the file content as a string, or None if not found or error.
        """
        try:
            endpoint = f"/repos/{owner}/{repo}/contents/{path}?ref={ref}"
            data = self._make_github_request(endpoint)
            if data is None or data.get("type") != "file":
                return None
            
            try:
                # GitHub API returns base64-encoded content
                import base64
                content = data.get("content", "")
                if data.get("encoding") == "base64":
                    content = base64.b64decode(content).decode('utf-8')
                return content
            except Exception as e:
                logger.warning(f"Failed to decode file content for {path}: {str(e)}")
                return None
        except GitHubInspectionError:
            # If we hit rate limits or other API errors during file fetching, just return None
            # This allows the analysis to continue with partial information
            logger.warning(f"Could not fetch file content for {path} due to API error")
            return None

    def _analyze_package_json(self, content: str) -> Dict[str, Any]:
        """Analyze package.json for build/start commands and dependencies."""
        try:
            package_data = json.loads(content)
            scripts = package_data.get("scripts", {})
            dependencies = package_data.get("dependencies", {})
            dev_dependencies = package_data.get("devDependencies", {})
            
            # Detect build and start commands
            build_command = None
            start_command = None
            
            if "build" in scripts:
                build_command = f"npm run build"
            if "start" in scripts:
                start_command = f"npm start"
            elif "dev" in scripts:
                start_command = f"npm run dev"
            
            # Detect common frameworks
            frameworks = []
            if "react" in dependencies or "react" in dev_dependencies:
                frameworks.append("React")
            if "vue" in dependencies or "vue" in dev_dependencies:
                frameworks.append("Vue.js")
            if "angular" in dependencies or "angular" in dev_dependencies:
                frameworks.append("Angular")
            if "next" in dependencies:
                frameworks.append("Next.js")
            if "express" in dependencies:
                frameworks.append("Express.js")
            if "fastify" in dependencies:
                frameworks.append("Fastify")
            
            return {
                "build_command": build_command,
                "start_command": start_command,
                "frameworks": frameworks,
                "package_manager": "npm",
                "has_dependencies": len(dependencies) > 0
            }
        except json.JSONDecodeError:
            logger.warning("Failed to parse package.json")
            return {}

    def _analyze_requirements_txt(self, content: str) -> Dict[str, Any]:
        """Analyze requirements.txt for Python dependencies and framework detection."""
        frameworks = []
        dependencies = []
        
        for line in content.strip().split('\n'):
            line = line.strip()
            if not line or line.startswith('#'):
                continue
            
            dependencies.append(line.split('==')[0].split('>=')[0].split('<=')[0].strip())
            
            # Detect common frameworks
            lower_line = line.lower()
            if 'django' in lower_line:
                frameworks.append("Django")
            elif 'flask' in lower_line:
                frameworks.append("Flask")
            elif 'fastapi' in lower_line:
                frameworks.append("FastAPI")
            elif 'tornado' in lower_line:
                frameworks.append("Tornado")
            elif 'aiohttp' in lower_line:
                frameworks.append("AIOHTTP")
        
        # Default build/start commands for Python
        build_command = None
        start_command = None
        
        if frameworks:
            if "Django" in frameworks:
                start_command = "python manage.py runserver"
            elif "Flask" in frameworks:
                start_command = "python app.py"  # Common default
            elif "FastAPI" in frameworks:
                start_command = "uvicorn main:app --reload"
        
        return {
            "build_command": build_command,
            "start_command": start_command,
            "frameworks": frameworks,
            "package_manager": "pip",
            "dependencies_count": len(dependencies)
        }

    def _analyze_pyproject_toml(self, content: str) -> Dict[str, Any]:
        """Analyze pyproject.toml for Python project configuration."""
        frameworks = []
        build_command = None
        start_command = None
        
        # Simple parsing for common framework indicators
        lower_content = content.lower()
        if 'django' in lower_content:
            frameworks.append("Django")
            start_command = "python manage.py runserver"
        elif 'flask' in lower_content:
            frameworks.append("Flask")
            start_command = "python app.py"
        elif 'fastapi' in lower_content:
            frameworks.append("FastAPI")
            start_command = "uvicorn main:app --reload"
        
        return {
            "build_command": build_command,
            "start_command": start_command,
            "frameworks": frameworks,
            "package_manager": "poetry" if "poetry" in lower_content else "pip"
        }

    def _analyze_dockerfile(self, content: str) -> Dict[str, Any]:
        """Analyze Dockerfile for configuration details."""
        analysis = {
            "base_image": None,
            "has_exposed_port": False,
            "exposed_ports": [],
            "has_healthcheck": False,
            "multi_stage": False,
            "uses_alpine": False
        }
        
        lines = content.split('\n')
        for line in lines:
            line = line.strip().upper()
            if line.startswith('FROM'):
                analysis["base_image"] = line.split()[1] if len(line.split()) > 1 else None
                if 'ALPINE' in line:
                    analysis["uses_alpine"] = True
                if 'AS' in line:
                    analysis["multi_stage"] = True
            elif line.startswith('EXPOSE'):
                analysis["has_exposed_port"] = True
                parts = line.split()
                if len(parts) > 1:
                    analysis["exposed_ports"].append(parts[1])
            elif line.startswith('HEALTHCHECK'):
                analysis["has_healthcheck"] = True
        
        return analysis

    def _analyze_docker_compose(self, content: str) -> Dict[str, Any]:
        """Analyze docker-compose.yml for service configuration."""
        try:
            compose_data = json.loads(content) if '{' in content else {}
            services = len(compose_data.get("services", {})) if compose_data else 0
            return {
                "services_count": services,
                "has_services": services > 0
            }
        except:
            return {"services_count": 0, "has_services": False}

    def _detect_environment_variables(self, content: str) -> List[str]:
        """Detect potential environment variable requirements from various file types."""
        env_vars = []
        
        # Common patterns for environment variables
        patterns = [
            r'process\.env\.([A-Z_][A-Z0-9_]*)',  # JavaScript/Node.js
            r'os\.getenv\(["\']([A-Z_][A-Z0-9_]*)["\']\)',  # Python
            r'ENV\["([A-Z_][A-Z0-9_]*)"\]',  # Ruby
            r'\$\{([A-Z_][A-Z0-9_]*)\}',  # Shell/Docker
            r'ENV\s+([A-Z_][A-Z0-9_]*)=',  # Docker ENV instruction
            r'([A-Z_][A-Z0-9_]*)\s*=',  # General assignment pattern
        ]
        
        for pattern in patterns:
            matches = re.findall(pattern, content)
            for match in matches:
                var_name = match
                if var_name and len(var_name) > 2 and var_name.isupper():
                    if var_name not in env_vars:
                        env_vars.append(var_name)
        
        return env_vars[:10]  # Limit to first 10 to avoid overwhelming response

    def _extract_owner_repo(self, repository_url: str) -> tuple[str, str]:
        """
        Extract owner and repository name from a GitHub URL.
        Supports: https://github.com/owner/repo
        """
        parsed = urlparse(repository_url)
        if parsed.netloc.lower() != "github.com" or parsed.scheme.lower() != "https":
            raise GitHubInspectionError("Invalid GitHub URL")
        
        path_parts = parsed.path.strip('/').split('/')
        if len(path_parts) < 2 or not path_parts[0] or not path_parts[1]:
            raise GitHubInspectionError("Invalid GitHub URL format")
        
        owner = path_parts[0]
        repo = path_parts[1].replace(".git", "")  # remove .git if present
        return owner, repo

    def _make_github_request(self, endpoint: str) -> Optional[Dict[Any, Any]]:
        """
        Make a request to the GitHub API and handle common errors.
        Returns JSON response as dict, or None if not found (404).
        Raises GitHubInspectionError for other errors.
        """
        url = f"{self.GITHUB_API_BASE}{endpoint}"
        try:
            response = self.session.get(url, timeout=10)
            if response.status_code == 200:
                return response.json()
            elif response.status_code == 404:
                return None
            elif response.status_code == 403:
                # Check if it's rate limiting
                if "X-RateLimit-Remaining" in response.headers and response.headers["X-RateLimit-Remaining"] == "0":
                    raise GitHubInspectionError("GitHub API rate limit exceeded. Please try again later.")
                else:
                    raise GitHubInspectionError("Access forbidden. The repository may be private or inaccessible.")
            else:
                raise GitHubInspectionError(f"GitHub API request failed with status {response.status_code}")
        except requests.RequestException as e:
            raise GitHubInspectionError(f"Failed to connect to GitHub: {str(e)}")
        except Exception as e:
            # Catch any other unexpected errors
            logger.error(f"Unexpected error in GitHub API request: {str(e)}", exc_info=True)
            raise GitHubInspectionError(f"Unexpected error in GitHub API request: {str(e)}")

    def _get_repository_info(self, owner: str, repo: str) -> Dict[str, Any]:
        """Get basic repository information."""
        endpoint = f"/repos/{owner}/{repo}"
        data = self._make_github_request(endpoint)
        if data is None:
            raise GitHubInspectionError(f"Repository '{owner}/{repo}' not found or is private")
        return {
            "name": data.get("name", repo),
            "full_name": data.get("full_name", f"{owner}/{repo}"),
            "description": data.get("description", ""),
            "default_branch": data.get("default_branch", "main"),
            "html_url": data.get("html_url", f"https://github.com/{owner}/{repo}")
        }

    def _get_repository_languages(self, owner: str, repo: str) -> Dict[str, int]:
        """Get programming languages used in the repository."""
        endpoint = f"/repos/{owner}/{repo}/languages"
        data = self._make_github_request(endpoint)
        return data if data is not None else {}

    def _check_file_exists(self, owner: str, repo: str, path: str, ref: str) -> bool:
        """Check if a file exists in the repository at the given ref (branch/tag/commit)."""
        endpoint = f"/repos/{owner}/{repo}/contents/{path}?ref={ref}"
        data = self._make_github_request(endpoint)
        return data is not None

    def _check_terraform_exists(self, owner: str, repo: str, ref: str) -> bool:
        """Check for Terraform files (*.tf) or a terraform directory."""
        # First, check for any .tf files in the root
        endpoint = f"/repos/{owner}/{repo}/contents?ref={ref}"
        data = self._make_github_request(endpoint)
        if data is None:
            return False
        
        # Look for .tf files in the root
        for item in data:
            if item["type"] == "file" and item["name"].endswith(".tf"):
                return True
            # Check for a terraform directory
            if item["type"] == "dir" and item["name"].lower() == "terraform":
                # We could check inside the directory, but for simplicity, we just note the directory exists
                return True
        
        # If not found in root, we could check subdirectories, but to keep it simple and avoid too many requests,
        # we'll just check the root. For a more thorough inspection, we would need to recursively check directories.
        # However, to avoid excessive API calls, we'll limit to root for now.
        return False

    def _detect_frameworks(self, languages: Dict[str, int], file_checks: Dict[str, bool], detailed_analysis: Dict[str, Any]) -> List[str]:
        """Detect likely frameworks based on languages, file presence, and detailed analysis."""
        frameworks = []
        
        # Add frameworks from detailed analysis if available
        if "package_json_analysis" in detailed_analysis:
            frameworks.extend(detailed_analysis["package_json_analysis"].get("frameworks", []))
        if "requirements_analysis" in detailed_analysis:
            frameworks.extend(detailed_analysis["requirements_analysis"].get("frameworks", []))
        if "pyproject_analysis" in detailed_analysis:
            frameworks.extend(detailed_analysis["pyproject_analysis"].get("frameworks", []))
        
        # If no frameworks from analysis but package.json exists, default to Node.js
        if not frameworks and file_checks.get("package_json"):
            frameworks.append("Node.js")
        
        # Check for languages if no frameworks detected yet
        if not frameworks:
            if languages.get("Python", 0) > 0:
                frameworks.append("Python")
            if languages.get("JavaScript", 0) > 0 or languages.get("TypeScript", 0) > 0:
                frameworks.append("Node.js")
            if languages.get("Go", 0) > 0:
                frameworks.append("Go")
            if languages.get("Rust", 0) > 0:
                frameworks.append("Rust")
            if languages.get("Java", 0) > 0:
                frameworks.append("Java")
        
        # Remove duplicates while preserving order
        seen = set()
        unique_frameworks = []
        for framework in frameworks:
            if framework not in seen:
                seen.add(framework)
                unique_frameworks.append(framework)
        
        return unique_frameworks

    def _detect_project_type(self, languages: Dict[str, int], frameworks: List[str]) -> str:
        """Determine the project type based on languages and frameworks."""
        if "React" in frameworks or "Vue.js" in frameworks or "Angular" in frameworks:
            return "frontend"
        elif "Django" in frameworks or "Flask" in frameworks or "FastAPI" in frameworks or "Express.js" in frameworks:
            return "backend"
        elif "Next.js" in frameworks:
            return "fullstack"
        elif "Node.js" in frameworks:
            # If it's Node.js but no specific framework detected, check languages
            if languages.get("TypeScript", 0) > 0 or languages.get("HTML", 0) > 0 or languages.get("CSS", 0) > 0:
                return "frontend"  # Likely a frontend project
            else:
                return "backend"  # Likely a backend project
        elif any(lang in languages for lang in ["JavaScript", "TypeScript", "Python", "Go", "Rust", "Java"]):
            return "application"
        else:
            return "unknown"

    def _detect_package_manager(self, file_checks: Dict[str, bool], detailed_analysis: Dict[str, Any]) -> str:
        """Detect the package manager based on files and analysis."""
        if "package_json_analysis" in detailed_analysis:
            return detailed_analysis["package_json_analysis"].get("package_manager", "unknown")
        if file_checks.get("package_json"):
            return "npm"  # Default to npm if package.json exists but analysis failed
        if file_checks.get("requirements_txt") or file_checks.get("pyproject_toml"):
            return "pip"
        if file_checks.get("go_mod"):
            return "go"
        if file_checks.get("cargo_toml"):
            return "cargo"
        if file_checks.get("pom_xml"):
            return "maven"
        return "unknown"

    def _check_ci_cd_configuration(self, owner: str, repo: str, ref: str) -> Dict[str, bool]:
        """Check for CI/CD configuration files."""
        ci_cd_checks = {}
        
        for key, path in self.CI_CD_FILES.items():
            if key == "github_actions":
                # Check for GitHub Actions directory
                endpoint = f"/repos/{owner}/{repo}/contents/.github?ref={ref}"
                data = self._make_github_request(endpoint)
                if data and isinstance(data, list):
                    # Check if workflows directory exists
                    for item in data:
                        if item.get("type") == "dir" and item.get("name") == "workflows":
                            ci_cd_checks[key] = True
                            break
                    else:
                        ci_cd_checks[key] = False
                else:
                    ci_cd_checks[key] = False
            else:
                ci_cd_checks[key] = self._check_file_exists(owner, repo, path, ref)
        
        return ci_cd_checks

    def inspect_repository(self, repository_url: str, branch: str) -> Dict[str, Any]:
        """
        Inspect a public GitHub repository and return comprehensive deployment readiness information.
        Enhanced to provide detailed project analysis including build commands, start commands, 
        environment variables, and CI/CD configuration.
        """
        logger.info(f"Starting repository inspection for {repository_url} on branch {branch}")
        
        try:
            owner, repo = self._extract_owner_repo(repository_url)
        except GitHubInspectionError as e:
            logger.error(f"Failed to extract owner/repo from URL: {str(e)}")
            return {
                "success": False,
                "error": str(e),
                "repository_url": repository_url,
                "branch": branch
            }

        # Get repository information
        try:
            repo_info = self._get_repository_info(owner, repo)
            logger.info(f"Successfully retrieved repository info for {owner}/{repo}")
        except GitHubInspectionError as e:
            logger.error(f"Failed to get repository info: {str(e)}")
            return {
                "success": False,
                "error": str(e),
                "repository_url": repository_url,
                "branch": branch
            }

        # Verify the branch exists
        try:
            endpoint = f"/repos/{owner}/{repo}/contents?ref={branch}"
            root_contents = self._make_github_request(endpoint)
            if root_contents is None:
                logger.error(f"Branch '{branch}' not found in repository '{owner}/{repo}'")
                return {
                    "success": False,
                    "error": f"Branch '{branch}' not found in repository '{owner}/{repo}'",
                    "repository_url": repository_url,
                    "branch": branch,
                    "default_branch": repo_info["default_branch"]
                }
        except GitHubInspectionError as e:
            logger.error(f"Failed to verify branch: {str(e)}")
            return {
                "success": False,
                "error": f"Failed to verify branch: {str(e)}",
                "repository_url": repository_url,
                "branch": branch
            }

        logger.info(f"Branch '{branch}' verified, proceeding with detailed analysis")

        # Get languages
        try:
            languages = self._get_repository_languages(owner, repo)
            logger.info(f"Detected languages: {list(languages.keys())}")
        except GitHubInspectionError as e:
            logger.warning(f"Could not get languages due to API error: {str(e)}")
            languages = {}

        # Check for specific files
        file_checks = {}
        try:
            for key, path in self.FILES_TO_CHECK.items():
                if key == "terraform":
                    file_checks[key] = self._check_terraform_exists(owner, repo, branch)
                else:
                    file_checks[key] = self._check_file_exists(owner, repo, path, branch)
            logger.info(f"File checks completed: {file_checks}")
        except GitHubInspectionError as e:
            logger.warning(f"Could not complete file checks due to API error: {str(e)}")
            # Set default values
            file_checks = {key: False for key in self.FILES_TO_CHECK.keys()}

        # Perform detailed analysis of key files
        detailed_analysis = {}
        
        # Analyze package.json if present
        if file_checks["package_json"]:
            logger.info("Analyzing package.json")
            try:
                package_json_content = self._get_file_content(owner, repo, "package.json", branch)
                if package_json_content:
                    detailed_analysis["package_json_analysis"] = self._analyze_package_json(package_json_content)
            except GitHubInspectionError as e:
                logger.warning(f"Could not analyze package.json due to API error: {str(e)}")
        
        # Analyze requirements.txt if present
        if file_checks["requirements_txt"]:
            logger.info("Analyzing requirements.txt")
            try:
                requirements_content = self._get_file_content(owner, repo, "requirements.txt", branch)
                if requirements_content:
                    detailed_analysis["requirements_analysis"] = self._analyze_requirements_txt(requirements_content)
            except GitHubInspectionError as e:
                logger.warning(f"Could not analyze requirements.txt due to API error: {str(e)}")
        
        # Analyze pyproject.toml if present
        if file_checks["pyproject_toml"]:
            logger.info("Analyzing pyproject.toml")
            try:
                pyproject_content = self._get_file_content(owner, repo, "pyproject.toml", branch)
                if pyproject_content:
                    detailed_analysis["pyproject_analysis"] = self._analyze_pyproject_toml(pyproject_content)
            except GitHubInspectionError as e:
                logger.warning(f"Could not analyze pyproject.toml due to API error: {str(e)}")
        
        # Analyze Dockerfile if present
        if file_checks["dockerfile"]:
            logger.info("Analyzing Dockerfile")
            try:
                dockerfile_content = self._get_file_content(owner, repo, "Dockerfile", branch)
                if dockerfile_content:
                    detailed_analysis["dockerfile_analysis"] = self._analyze_dockerfile(dockerfile_content)
            except GitHubInspectionError as e:
                logger.warning(f"Could not analyze Dockerfile due to API error: {str(e)}")
        
        # Analyze docker-compose.yml if present
        if file_checks["docker_compose"]:
            logger.info("Analyzing docker-compose.yml")
            try:
                compose_content = self._get_file_content(owner, repo, "docker-compose.yml", branch)
                if compose_content:
                    detailed_analysis["docker_compose_analysis"] = self._analyze_docker_compose(compose_content)
            except GitHubInspectionError as e:
                logger.warning(f"Could not analyze docker-compose.yml due to API error: {str(e)}")

        # Detect environment variables from various files
        env_vars = []
        try:
            if file_checks["package_json"]:
                content = self._get_file_content(owner, repo, "package.json", branch)
                if content:
                    env_vars.extend(self._detect_environment_variables(content))
            if file_checks["requirements_txt"]:
                content = self._get_file_content(owner, repo, "requirements.txt", branch)
                if content:
                    env_vars.extend(self._detect_environment_variables(content))
            if file_checks["dockerfile"]:
                content = self._get_file_content(owner, repo, "Dockerfile", branch)
                if content:
                    env_vars.extend(self._detect_environment_variables(content))
            if file_checks["docker_compose"]:
                content = self._get_file_content(owner, repo, "docker-compose.yml", branch)
                if content:
                    env_vars.extend(self._detect_environment_variables(content))
        except GitHubInspectionError as e:
            logger.warning(f"Could not detect environment variables due to API error: {str(e)}")
        
        # Remove duplicates and limit
        env_vars = list(set(env_vars))[:10]
        logger.info(f"Detected environment variables: {env_vars}")

        # Check for CI/CD configuration
        try:
            ci_cd_config = self._check_ci_cd_configuration(owner, repo, branch)
            logger.info(f"CI/CD configuration: {ci_cd_config}")
        except GitHubInspectionError as e:
            logger.warning(f"Could not check CI/CD configuration due to API error: {str(e)}")
            ci_cd_config = {key: False for key in self.CI_CD_FILES.keys()}

        # Detect frameworks with enhanced analysis
        frameworks = self._detect_frameworks(languages, file_checks, detailed_analysis)
        logger.info(f"Detected frameworks: {frameworks}")

        # Detect project type
        project_type = self._detect_project_type(languages, frameworks)
        logger.info(f"Detected project type: {project_type}")

        # Detect package manager
        package_manager = self._detect_package_manager(file_checks, detailed_analysis)
        logger.info(f"Detected package manager: {package_manager}")

        # Determine build and start commands from analysis
        build_command = None
        start_command = None
        
        if "package_json_analysis" in detailed_analysis:
            build_command = detailed_analysis["package_json_analysis"].get("build_command")
            start_command = detailed_analysis["package_json_analysis"].get("start_command")
        elif "requirements_analysis" in detailed_analysis:
            build_command = detailed_analysis["requirements_analysis"].get("build_command")
            start_command = detailed_analysis["requirements_analysis"].get("start_command")
        elif "pyproject_analysis" in detailed_analysis:
            build_command = detailed_analysis["pyproject_analysis"].get("build_command")
            start_command = detailed_analysis["pyproject_analysis"].get("start_command")

        # Determine deployment readiness and warnings
        warnings = []
        deployment_readiness = "not_ready"

        # Check for deployment files
        has_docker = file_checks["dockerfile"] or file_checks["docker_compose"] or file_checks["compose"]
        has_terraform = file_checks["terraform"]
        has_package_json = file_checks["package_json"]
        has_requirements = file_checks["requirements_txt"] or file_checks["pyproject_toml"]
        has_go = file_checks["go_mod"]
        has_cargo = file_checks["cargo_toml"]
        has_pom = file_checks["pom_xml"]

        if has_docker or has_terraform or has_package_json or has_requirements or has_go or has_cargo or has_pom:
            deployment_readiness = "ready"
        else:
            warnings.append("No Dockerfile, Terraform, or recognizable project files detected.")

        # Add more specific warnings
        if not file_checks["dockerfile"] and not file_checks["docker_compose"] and not file_checks["compose"]:
            warnings.append("No Dockerfile or Docker Compose file detected.")
        if not file_checks["terraform"]:
            warnings.append("No Terraform files or directory detected.")
        if not file_checks["package_json"] and not file_checks["requirements_txt"] and not file_checks["pyproject_toml"]:
            warnings.append("No package.json, requirements.txt, or pyproject.toml detected.")
        
        # Add informational warnings
        if not any(ci_cd_config.values()):
            warnings.append("No CI/CD configuration detected.")
        if not env_vars and (has_package_json or has_requirements):
            warnings.append("No environment variables detected - may need manual configuration.")

        # Build the comprehensive result
        result = {
            "success": True,
            "repository_name": repo_info["name"],
            "repository_url": repository_url,
            "branch": branch,
            "description": repo_info["description"],
            "default_branch": repo_info["default_branch"],
            
            # Language and framework detection
            "languages": list(languages.keys()),
            "primary_language": max(languages.keys(), key=lambda k: languages[k]) if languages else "unknown",
            "frameworks": frameworks,
            "project_type": project_type,
            "package_manager": package_manager,
            
            # File detection
            "files": {
                "package_json": file_checks["package_json"],
                "requirements_txt": file_checks["requirements_txt"],
                "pyproject_toml": file_checks["pyproject_toml"],
                "dockerfile": file_checks["dockerfile"],
                "docker_compose": file_checks["docker_compose"] or file_checks["compose"],
                "terraform": file_checks["terraform"],
                "makefile": file_checks["makefile"],
                "env_example": file_checks["env_example"] or file_checks["env_sample"]
            },
            
            # Docker configuration
            "docker_configuration": {
                "has_dockerfile": file_checks["dockerfile"],
                "has_docker_compose": file_checks["docker_compose"] or file_checks["compose"],
                "dockerfile_path": "./Dockerfile" if file_checks["dockerfile"] else None,
                "dockerfile_analysis": detailed_analysis.get("dockerfile_analysis", {}),
                "docker_compose_analysis": detailed_analysis.get("docker_compose_analysis", {})
            },
            
            # Terraform configuration
            "terraform_configuration": {
                "has_terraform": file_checks["terraform"],
                "terraform_path": "./terraform" if file_checks["terraform"] else None
            },
            
            # CI/CD configuration
            "ci_cd_configuration": ci_cd_config,
            
            # Build and run commands
            "build_command": build_command,
            "start_command": start_command,
            
            # Environment variables
            "environment_variables": env_vars,
            "has_env_example": file_checks["env_example"] or file_checks["env_sample"],
            
            # Deployment readiness
            "deployment_readiness": deployment_readiness,
            "warnings": warnings,
            
            # Detailed analysis results
            "detailed_analysis": detailed_analysis
        }

        logger.info(f"Repository inspection completed successfully for {owner}/{repo}")
        return result

def inspect_github_repository(repository_url: str, branch: str) -> Dict[str, Any]:
    """
    Convenience function to inspect a GitHub repository.
    Returns a dictionary with the inspection result or error information.
    """
    inspector = RepositoryInspector()
    return inspector.inspect_repository(repository_url, branch)
